  "narrative": {
    "northStar": "The Evening Deal Board",
    "overview": "RPG Hunt is a deal board read after dark: warm near-black surfaces, parchment-colored text, and one ochre accent that marks only what earns a click (the discount, the buy button, the selected filter, the stars). It is browsed in the evening, between sessions, often on a phone, so the page is always dark and dense enough to scan in seconds.\n\nThe structure is a marketplace front page in the AppSumo mould: a thin ochre announcement bar, a sticky header with a pill search, a centered headline, a short trust row, a ranked Top 9 list, then rows of four deal cards each with a View all button. Every deal card has the same layout and always shows a cover image, so the eye learns one card and reads the rest.\n\nType is a single family, Archivo, used across its width axis: condensed and heavy for prices, rank numerals and headlines; wide for the wordmark; normal width for reading. There are no serif faces anywhere. Depth comes from tonal steps between three dark surfaces and hairline borders, not from shadows.",
    "keyCharacteristics": [
      "Always dark, warm umber-tinted neutrals.",
      "One accent (ochre), used sparingly for price, action and selection.",
      "One typeface (Archivo), with personality carried by width and weight, not by a second family.",
      "Flat surfaces separated by 1px warm borders; no drop shadows.",
      "Identical deal cards: cover, title, rating, price, summary, end date, buttons, shop domain."
    ],
    "rules": [
      {
        "name": "The Always Dark Rule",
        "body": "The site has no light theme. `color-scheme: dark` is set on the root; every new surface uses the night, lamp and chip steps.",
        "section": "colors"
      },
      {
        "name": "The One Accent Rule",
        "body": "Ochre is the only accent color. Red is not the accent; Ember appears only for an urgent deadline.",
        "section": "colors"
      },
      {
        "name": "The No Serif Rule",
        "body": "Archivo is the only family. Do not introduce a serif or a second display face; vary width and weight instead.",
        "section": "typography"
      },
      {
        "name": "The Rating Wording Rule",
        "body": "Ratings read exactly \"★ 4.9 from 393 ratings\": an ochre star, one decimal, the count with thousands separators, the word \"ratings\".",
        "section": "typography"
      },
      {
        "name": "The Flat Board Rule",
        "body": "No drop shadows. The only box-shadow in the system is a 2px ochre ring marking a focused card, a state signal, not elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every surface dark: night background, lamp card, chip umber.",
      "Do reserve ochre for price badges, the main action, selection, stars and focus.",
      "Do show a cover image on every deal and keep every deal card in the same order.",
      "Do show the shop once per card, as its bare domain in small muted text under the buttons.",
      "Do write ratings as \"★ 4.9 from 393 ratings\".",
      "Do use Archivo's width axis (condensed for numbers, wide for the wordmark) instead of adding fonts.",
      "Do keep the AppSumo-style home order: announcement bar, header with search, headline, trust row, Top 9, rows of 4 with View all."
    ],
    "donts": [
      "Don't add a light theme or light surfaces.",
      "Don't use red or any second hue as the accent.",
      "Don't use serif fonts anywhere.",
      "Don't repeat information on a card (no shop name in two places, no duplicated price or label).",
      "Don't add drop shadows to cards or buttons."
    ]
  }
}