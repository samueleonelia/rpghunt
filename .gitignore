# Dependencies and build output (if code is added later)
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/

# Large downloaded assets (PDFs, scraped dumps)
downloads/
*.zip

# Impeccable design engine binary (16 MB, re-downloaded by its launcher)
.claude/skills/impeccable/scripts/bin/

# Impeccable working files (decision page payloads, sketches, review captures)
.impeccable/decision/
.impeccable/mocks/
.impeccable/review/
.impeccable/live/sessions/
.impeccable/live/inject-journal.json
.impeccable/live/roots.json

# Daily scraper output (about 2 MB a day; the run report and score are kept)
data/deals/raw/*-scraper.json

# Jev answer cache (re-runs and tuning cost nothing; rebuilt on demand) and test-double output
data/jev-cache/
data/deals/raw/*-checked-FAKE.json
data/deals/check-report-*-FAKE.json
data/deals/raw/*-checked.json
# Price history: local for now (about 0.3 MB rewritten a day); decide where it lives when the daily run is set up
data/prices/
# Escalation test-double output
data/deals/escalation-*-FAKE.json
data/deals/needs-owner-*-FAKE.json
